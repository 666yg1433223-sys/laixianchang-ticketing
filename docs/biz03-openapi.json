            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmptyCancel"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Durable acceptance only, NOT paid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentAccepted"
                }
              }
            }
          },
          "400": {
            "description": "Strict input/identity/ownership/conflict/unknown commit. PAYMENT_ACCEPTANCE_UNKNOWN: retry original key or query original ID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Strict input/identity/ownership/conflict/unknown commit. PAYMENT_ACCEPTANCE_UNKNOWN: retry original key or query original ID.",
            "content": {
