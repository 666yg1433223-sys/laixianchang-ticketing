# Local learning environment only. These are placeholders, not working credentials.
# Recommended: pwsh -File scripts/run-learning.ps1 -Action Init
# The script generates four independent random passwords in the ignored .env file.
# If filling this file manually, use 64 lowercase hexadecimal characters per password.
TICKETING_MYSQL_ROOT_PASSWORD=REPLACE_WITH_RANDOM_ROOT_PASSWORD
TICKETING_DB_PASSWORD=REPLACE_WITH_RANDOM_APPLICATION_PASSWORD
TICKETING_MIGRATOR_PASSWORD=REPLACE_WITH_RANDOM_MIGRATION_PASSWORD
TICKETING_REDIS_PASSWORD=REPLACE_WITH_RANDOM_REDIS_PASSWORD
